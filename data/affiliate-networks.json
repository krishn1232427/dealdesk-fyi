  "scope": "A comprehensive working register of credible affiliate networks, subnetworks, creator-commerce platforms, CPA networks, and merchant-owned programs relevant to a US consumer-deals publisher. The market is open-ended, so the daily refresh adds credible networks as they are discovered rather than claiming this is every regional or private network worldwide.",
  "publicationRule": "A network-level status never authorizes an offer. DealDesk may publish only an approved merchant relationship with an exact payable DealDesk tracking link, a verified live offer, and genuine merchant or product imagery. Unpaid, pending, untracked, unavailable, broken, or visually unverified offers stay hidden.",
  "refreshPolicy": {
    "cadence": "daily",
    "timezone": "America/Los_Angeles",
    "reviewEveryRecord": true,
    "discoverNewNetworks": true,
    "updateLastCheckedOnlyAfterReview": true,
    "materialChanges": [
      "new or closed network",
      "migration or acquisition",
      "publisher signup URL change",
      "DealDesk account or site approval change",
      "merchant or commission access change",
      "payout readiness change",
      "broken official, signup, dashboard, or evidence URL"
    ]
  },
  "statusDefinitions": {
    "active_payable": "DealDesk has at least one approved, verified payable relationship on this platform; individual offers still require verification.",
    "active_no_payable_program": "The publisher account is active, but no approved payable merchant relationship is currently available.",
    "active_limited": "The account exists, but its type or access level blocks the programs DealDesk needs.",
    "pending_review": "An application or site review is pending.",
    "declined": "DealDesk's application was declined; no offer may publish through this network unless a later approval is verified.",
    "onboarding": "An account exists, but required onboarding or program-level verification is incomplete.",
    "not_started": "No DealDesk application has been submitted.",
    "migrating": "The platform is being moved into another canonical network and should not receive a new standalone application.",
    "closed": "The platform has closed and is retained only to resolve old names or links."
  },
